# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ML — data files (too large for git, download from Kaggle)
ml_model/data/*.csv
ml_model/data/*.tsv
ml_model/data/Smishing-Dataset-IMC25/
ml_model/data/reference/
ml_model/data/prepared/

# ML — trained model artefacts (generated by running train.py)
ml_model/models/*.pkl
!ml_model/models/model_bundle.pkl
!ml_model/models/hybrid_bundle.pkl
ml_model/models/metrics.json

# Local Python environment and caches
/.local-runtime/
/.venv/
__pycache__/
*.pyc

# Reproducible training outputs, split identities and model logs
ml_model/models/*.tmp
ml_model/models/*.log
ml_model/models/split_ids.json
