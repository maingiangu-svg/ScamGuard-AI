{
  "manifest_version": 3,
  "name": "ScamGuard AI Threat Detector",
  "version": "1.0.0",
  "description": "Chrome Extension for ScamGuard AI Threat Detector",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["overlay.css"],
      "js": ["content.js"]
    }
  ]
}
