{
  "manifest_version": 3,
  "name": "ScamGuard AI Threat Detector",
  "version": "2.0.0",
  "key": "",
  "description": "Chrome Extension for ScamGuard AI Threat Detector",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost/*"
  ],
  "action": {"default_popup": "popup.html", "default_title": "ScamGuard — kiểm tra theo yêu cầu"},
  "background": {
    "service_worker": "background.js"
  }
}
