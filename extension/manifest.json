{
  "manifest_version": 3,
  "name": "ScamGuard AI Threat Detector",
  "version": "1.1.2",
  "key": "",
  "description": "Chrome Extension for ScamGuard AI Threat Detector",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {"default_popup": "popup.html", "default_title": "ScamGuard — chọn chế độ quét"},
  "background": {
    "service_worker": "background.js"
  }
}
